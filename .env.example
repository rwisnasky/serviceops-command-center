# ─────────────────────────────────────────────────────────────────────────────
# ServiceOps Command Center — environment
#
# For the demo, you need exactly three lines. Copy this file to `.env`:
#
#     DEMO_MODE=true
#     SESSION_SECRET=<anything random>
#     DB_PATH=./data/demo.db
#
# Everything below that is either demo tuning or the real-deployment config,
# which is unused while DEMO_MODE=true.
# ─────────────────────────────────────────────────────────────────────────────


# ── Demo mode ────────────────────────────────────────────────────────────────

# The master switch. When on, every external system (ServiceTitan, GoHighLevel,
# YouTube, OpenAI, Google Geocoding) is replaced by an in-process mock, the
# background pollers and crons do not start, and an outbound network guard
# blocks any request that isn't to localhost.
#
# It FAILS SAFE: demo mode is the default, including when this variable is
# unset entirely. You have to opt out with DEMO_MODE=false to run against real
# systems. (Clone-and-run should never quietly point at production.)
DEMO_MODE=true

# Reshuffles the entire generated company — different customers, jobs, invoices,
# calls. Any integer. The same seed always produces the same world, which is why
# screenshots stay valid.
# DEMO_SEED=20260728

# Login for the demo account. Seeded on boot and reset to this value on every
# restart, so a visitor who changes it can't lock out the next one.
# DEMO_USER_EMAIL=demo@groundedhs.example
# DEMO_USER_PASSWORD=demo1234

# Artificial latency on mocked API calls, in ms. Default 0 (snappy). Set to
# ~250 when recording a walkthrough so loading states are actually visible.
# DEMO_LATENCY_MS=0

# AI behaviour:
#   (unset)  canned responses, no key needed, no cost          <- default
#   live     real OpenAI calls; requires OPENAI_API_KEY below
# Only turn this on for a live interview demo. A public URL with live AI is a
# stranger spending your credits.
# DEMO_AI=live
# DEMO_AI_LATENCY_MS=600

# Escape hatches for exercising failure paths on purpose:
#   DEMO_PAYROLL_SCOPE=denied     Payroll endpoints 403 -> scoreboard shows its
#                                 "missing scope" warning instead of wrong numbers
#   DEMO_EQUIPMENT_WRITE=denied   Equipment writes 403 -> registrations persist
#                                 as st_write_status='failed' for later retry
#   DEMO_ALLOW_NETWORK=true       Disables the outbound guard. Don't.


# ── Core app (required in every mode) ────────────────────────────────────────

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# SQLite location. Locally anything writable works. On Railway this must point
# at the mounted volume (/data/calls.db) or the database resets on every deploy.
DB_PATH=./data/demo.db

PORT=3000
NODE_ENV=development

# Seeds the first login when the users table is empty. In demo mode the demo
# account is created for you and these can stay unset.
# FIRST_USER_EMAIL=
# FIRST_USER_PASSWORD=
# FIRST_USER_DISPLAY_NAME=


# ─────────────────────────────────────────────────────────────────────────────
# Everything below is for running against real systems (DEMO_MODE=false).
# Leave it all blank for the demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── ServiceTitan ─────────────────────────────────────────────────────────────
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
# Optional defaults the PO / estimate writers fall back to
ST_DEFAULT_SKU_ID=
ST_DEFAULT_BUSINESS_UNIT_ID=
ST_PO_TYPE_ID=
ST_INVENTORY_LOCATION_ID=
ST_ENABLE_MEMBERSHIP_CREATE=false
ST_FREE_MEMBERSHIP_TYPE_ID=
ST_FREE_MEMBERSHIP_PLAN=
ST_FREE_MEMBERSHIP_BU_ID=

# ── GoHighLevel ──────────────────────────────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_RETURN_VISIT_WORKFLOW_ID=
GHL_RETURN_VISIT_STAGE_ID=
GHL_HAPPY_REVIEW_WORKFLOW_ID=
GHL_HAPPY_REVIEW_WEBHOOK_URL=
GHL_FAN_CLUB_WORKFLOW_ID=
GHL_MEMBERSHIP_WEBHOOK_URL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Powers call transcription + classification, warranty-label OCR, invoice and
# scope-of-work parsing, and pricebook matching. Not needed unless DEMO_AI=live.
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=
CLASSIFICATION_MODEL=
INVOICE_PARSER_MODEL=
SCOPE_PARSER_MODEL=
PRICEBOOK_MATCH_MODEL=
BRADFORD_WHITE_PARSER_MODEL=
JOB_SUMMARY_MODEL=
OPENAI_RENAME_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=

# ── Google ───────────────────────────────────────────────────────────────────
# Geocoding, for the address audit. Mocked in demo mode.
GOOGLE_MAPS_API_KEY=

# ── YouTube ──────────────────────────────────────────────────────────────────
# Job walkthrough video uploads. See docs/YOUTUBE_SETUP.md.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Pollers / crons (real mode only) ─────────────────────────────────────────
CALL_POLL_INTERVAL_MINUTES=5
CALL_POLL_LOOKBACK_HOURS=6
CALL_POLL_OVERLAP_MINUTES=10
CALL_AUTO_PROCESS=true
FORMS_POLL_INTERVAL_MINUTES=15
FORMS_POLL_LOOKBACK_HOURS=6
FORMS_POLL_MAX_LOOKBACK_HOURS=72
DB_BACKUP_KEEP=7

# ── Misc ─────────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=
ADMIN_API_KEY=
LABOR_RATE=
